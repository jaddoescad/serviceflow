# ServiceFlow Supabase project the admin reads from.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Edge function base (defaults to <SUPABASE_URL>/functions/v1 if unset).
# NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=https://your-project.supabase.co/functions/v1

# Server-only: the clock-out CLI and online card payments (/api/pay and the
# Stripe webhook) need it. Never prefix this key with NEXT_PUBLIC_ and never
# expose it to browser code.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
# TIME_ENTRY_ADMIN_EMAIL=info@paintersottawa.com

# Calculator assistant (server-side only — never NEXT_PUBLIC_).
OPENAI_API_KEY=sk-your-key
# OPENAI_MODEL=gpt-5-mini

# Google Calendar sync (Settings › Google Calendar; server-side only). OAuth
# client redirect URI: <site origin>/api/google-calendar/callback. The
# calendar-sync edge function needs the same two values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Address suggestions on address fields (server-side only). A Google Cloud key
# restricted to the Places API (New).
GOOGLE_PLACES_API_KEY=
