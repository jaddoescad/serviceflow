{
  "name": "serviceflow-admin",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "clock-out": "node scripts/time-entry-cli.mjs clock-out",
    "hermes:time": "node scripts/hermes-time-entry-cli.mjs",
    "hermes:gmail-label": "node scripts/ottawa-gmail-label-cli.mjs",
    "hermes:email-intake": "node scripts/ottawa-email-intake-cli.mjs",
    "hermes:dripjobs-sync": "node scripts/dripjobs-daily-sync-runner.mjs",
    "hermes:meta-sync": "node scripts/meta-marketing-daily-sync.mjs",
    "tasks": "node scripts/project-task-cli.mjs",
    "audit:job-cost-identity": "node scripts/audit-job-cost-allocation-identity.mjs",
    "audit:marketing": "node scripts/audit-marketing-attribution.mjs",
    "reconcile:dripjobs-jobs": "node scripts/reconcile-dripjobs-job-source.mjs",
    "reconcile:job-cost-identity": "node scripts/backfill-job-cost-allocation-identity.mjs",
    "reconcile:dripjobs-tests-and-leads": "node scripts/reconcile-dripjobs-test-and-missing-leads.mjs",
    "reconcile:lead-job-links": "node scripts/backfill-marketing-lead-job-links.mjs",
    "reconcile:lead-project-links": "node scripts/backfill-marketing-lead-project-links.mjs",
    "import:marketing": "node scripts/import-marketing-attribution.mjs",
    "import:meta-api": "node scripts/import-meta-api-snapshots.mjs",
    "import:meta-monthly": "node scripts/import-meta-monthly-snapshots.mjs",
    "import:dripjobs-marketing": "node scripts/import-dripjobs-marketing-exports.mjs",
    "import:marketing-leads": "node scripts/import-marketing-leads-sheet.mjs",
    "meta": "node scripts/meta-marketing-cli.mjs",
    "ottawa": "node scripts/ottawa-cli.mjs",
    "ottawa-source": "node scripts/ottawa-source-cli.mjs",
    "hermes:install": "node hermes/install.mjs",
    "test:task-cli": "node --test scripts/project-task-cli.test.mjs",
    "test:time-cli": "node --test scripts/time-entry-cli.test.mjs",
    "test:hermes-time-cli": "node --test scripts/hermes-time-entry-cli.test.mjs",
    "test:hermes-meta-ads": "node --test scripts/hermes-meta-ads-report.test.mjs",
    "test:hermes-meta-sync": "node --test scripts/meta-marketing-daily-sync.test.mjs",
    "test:project-sort": "node --experimental-strip-types --test scripts/project-sort.test.mjs",
    "test:project-routing": "tsc src/lib/project-routing.ts --module commonjs --target es2022 --moduleResolution node --outDir .test-dist/project-routing --skipLibCheck && node --test scripts/project-routing.test.mjs",
    "test:calculator": "tsc src/lib/calculator/engine.ts src/lib/calculator/operations.ts --module commonjs --target es2022 --moduleResolution node --outDir .test-dist --skipLibCheck && node --test scripts/calculator-engine.test.mjs",
    "test:labour-percentages": "node --experimental-strip-types --test scripts/labour-cost-percentages.test.mjs",
    "test:dripjobs-job-identity": "node --test scripts/dripjobs-job-identity.test.mjs",
    "test:marketing-sales": "node --experimental-strip-types --test scripts/marketing-sales-metrics.test.mjs",
    "test:dripjobs-live-ingest": "node --test scripts/dripjobs-live-ingest.test.mjs",
    "test:dripjobs-daily-sync": "node --test scripts/dripjobs-jobs-list.test.mjs scripts/dripjobs-sales-list.test.mjs scripts/dripjobs-job-authority.test.mjs scripts/dripjobs-daily-sync-runner.test.mjs",
    "test:default-job-budget": "node --test scripts/default-job-budget.test.mjs",
    "mobile:start": "npm --prefix apps/mobile start",
    "mobile:install": "npm --prefix apps/mobile ci",
    "mobile:check": "npm --prefix apps/mobile run qa:secrets"
  },
  "dependencies": {
    "@openai/agents": "^0.13.5",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.107.0",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "next": "^15.5.4",
    "pdfjs-dist": "5.4.296",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.0",
    "fake-indexeddb": "6.2.5",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.6.3"
  }
}
