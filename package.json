{
  "name": "ottawa-painters-app",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": "20 || >=22"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "office": "node scripts/office.cjs",
    "deploy:android:closed": "eas build --platform android --profile production --auto-submit --non-interactive",
    "submit:android:closed": "eas submit --platform android --profile production --latest --non-interactive",
    "web": "expo start --web",
    "qa:node": "node scripts/qa-node-version.cjs",
    "qa:doctor": "expo-doctor",
    "qa:web": "expo start --web --port 19006",
    "qa:audit": "npm audit --audit-level=moderate",
    "qa:secrets": "node scripts/qa-secrets.cjs",
    "qa:rls": "node scripts/qa-supabase-rls.cjs",
    "qa:budget": "node scripts/qa-project-budget-sql.mjs",
    "qa:labour-budget": "node scripts/qa-project-labour-budget-sql.mjs",
    "qa:labour-tasks-mobile": "node scripts/qa-project-labour-tasks-mobile.mjs",
    "qa:labour-task-reasons": "node scripts/qa-labour-task-over-budget-reasons.mjs",
    "qa:project-clock-ins": "node scripts/qa-project-clock-in-summary.mjs",
    "qa:lead-clock-in": "node scripts/qa-lead-clock-in-sql.mjs",
    "qa:project-media": "node scripts/qa-project-media.mjs",
    "qa:project-media-sql": "node scripts/qa-project-media-sql.mjs",
    "import:companycam-media": "node --env-file=.env.local scripts/import-companycam-media.mjs",
    "qa:location": "node scripts/qa-location-tracking.cjs",
    "qa:v2-client": "node scripts/qa-v2-client.cjs",
    "qa:time-entry-backend": "node scripts/qa-time-entry-commands.mjs",
    "qa:smoke:web": "node scripts/qa-web-smoke.cjs",
    "qa:preflight": "npm run qa:node && npm run qa:doctor && npm run qa:secrets && npm run qa:location && npm run qa:v2-client && npm run qa:audit",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.107.0",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.14",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.20",
    "expo-video": "~3.0.16",
    "leaflet": "^1.9.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "^1.29.0",
    "react-native-nitro-image": "^0.15.1",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-vision-camera": "^5.2.2",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "expo-doctor": "^1.19.10",
    "patch-package": "^8.0.1",
    "playwright-core": "^1.61.1",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "js-yaml": "3.15.0",
    "postcss": "8.5.16",
    "undici": "6.27.0",
    "uuid": "11.1.1"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-image"
        ]
      }
    }
  }
}
