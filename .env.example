EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
EXPO_PUBLIC_EAS_PROJECT_ID=your_eas_project_id
EXPO_PUBLIC_LOCATION_TRACKING_ENABLED=1
# Leave empty to enable for everyone, or use comma-separated pilot emails.
EXPO_PUBLIC_LOCATION_TRACKING_PILOT_EMAILS=

# Google Maps (native build only — injected at prebuild, not bundled into JS).
# Use one shared key, or set the per-platform vars for restricted keys.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# GOOGLE_MAPS_API_KEY_IOS=your_ios_restricted_key
# GOOGLE_MAPS_API_KEY_ANDROID=your_android_restricted_key

# Office CLI only. Keep real values in .env.local or your shell, never in git.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
ASSIGNMENT_ADMIN_TOKEN=your_assignment_admin_token
ASSIGNMENT_MANAGER_JWT=your_manager_jwt

# Supabase Edge Function / Cron secrets.
# Store CLOCK_IN_REMINDER_CRON_SECRET as a Supabase function secret and in Vault
# under the name clock_in_reminder_cron_secret. Store SUPABASE_URL in Vault as
# project_url for the scheduled cron migration.
CLOCK_IN_REMINDER_CRON_SECRET=replace_with_long_random_secret
LOCATION_TRACKING_ALERT_CRON_SECRET=replace_me
COMPANYCAM_API_KEY=your_companycam_api_key
COMPANYCAM_SYNC_CRON_SECRET=your_companycam_sync_cron_secret

# Web QA smoke test credentials for a dedicated production QA user.
QA_EMAIL=qa-web@example.com
QA_PASSWORD=replace_me
QA_PROJECT_SEARCH=qa
QA_ALLOW_DESTRUCTIVE=0
