#!/usr/bin/env node

import { existsSync } from "node:fs";
import { main } from "./hermes-time-entry-cli.mjs";

try {
  const args = process.argv.slice(2);
  const hermesEnvFile = "/opt/data/hermes-time-entry.env";
  if (existsSync(hermesEnvFile) && !args.some((arg) => arg === "--env-file" || arg.startsWith("--env-file="))) {
    args.push("--env-file", hermesEnvFile);
  }
  process.exitCode = await main(args);
} catch (error) {
  const message = error instanceof Error ? error.message : String(error);
  process.stderr.write(
    process.argv.includes("--json")
      ? `${JSON.stringify({ schema_version: 1, status: "error", error: message })}\n`
      : `Error: ${message}\n`,
  );
  process.exitCode = 1;
}
